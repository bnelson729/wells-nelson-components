{
	"name": "@wells-nelson/displays",
	"version": "0.0.0",
	"description": "Svelte 5 display components and theme CSS shared by Wells Nelson apps.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bnelson729/wells-nelson-components.git",
		"directory": "src/npm/displays"
	},
	"homepage": "https://github.com/bnelson729/wells-nelson-components/tree/main/src/npm/displays#readme",
	"bugs": {
		"url": "https://github.com/bnelson729/wells-nelson-components/issues"
	},
	"type": "module",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./theme.css": "./dist/theme.css",
		"./palettes/*": "./dist/palettes/*"
	},
	"files": [
		"dist"
	],
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"build": "svelte-package -i src/lib -o dist",
		"check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"test": "vitest run",
		"lint:package": "publint"
	},
	"peerDependencies": {
		"svelte": "^5.40.0"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
