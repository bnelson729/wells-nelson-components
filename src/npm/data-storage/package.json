{
	"name": "@wells-nelson/data-storage",
	"version": "0.0.0",
	"description": "Offline-first storage for Wells Nelson apps: RxDB + TanStack DB data sets, Supabase sync of shared containers, tombstones, device prefs and a SQL migration generator.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bnelson729/wells-nelson-components.git",
		"directory": "src/npm/data-storage"
	},
	"homepage": "https://github.com/bnelson729/wells-nelson-components/tree/main/src/npm/data-storage#readme",
	"bugs": {
		"url": "https://github.com/bnelson729/wells-nelson-components/issues"
	},
	"type": "module",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./sql": {
			"types": "./dist/sql.d.ts",
			"default": "./dist/sql.js"
		}
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"scripts": {
		"build": "svelte-package -i src/lib -o dist",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"lint:package": "publint"
	},
	"peerDependencies": {
		"@supabase/supabase-js": "^2.100.0",
		"@tanstack/db": "^1.0.0-rc.1.4",
		"@tanstack/rxdb-db-collection": "^1.0.0-rc.1.4",
		"rxdb": "^17.6.0",
		"rxjs": "^7.8.2",
		"svelte": "^5.40.0"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.16",
		"@supabase/supabase-js": "^2.119.0",
		"@tanstack/db": "^1.0.0-rc.1.5",
		"@tanstack/rxdb-db-collection": "^1.0.0-rc.1.5",
		"rxdb": "^17.6.0",
		"rxjs": "^7.8.2"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
